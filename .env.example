# Auth0 Configuration
PUBLIC_AUTH0_DOMAIN="fulcra.us.auth0.com"
PUBLIC_AUTH0_CLIENT_ID="whF3ymxsYHijh2QrGkGbgDkxqDDAA8KB"

# Fulcra API Endpoint (used for Auth0 audience and server-side API calls)
PUBLIC_FULCRA_API_ENDPOINT="https://api.fulcradynamics.com/"
# For local development, use:
# PUBLIC_FULCRA_API_ENDPOINT="http://localhost:8008/"

# ---- Agency Brain demo ----
# Serve the fictional agency in /demo to anyone signed in: the owner's view
# (cards, Access, Console) with a switch to a teammate's view. Read-only.
# No Fulcra files or shares needed. Set to false to read real brains from Fulcra.
DEMO_FIXTURES=true

# Fulcra folder that holds clients/<slug>/ and team.json (server-side).
AGENCY_ROOT=/demo-agency
# Same value, shown in the UI.
PUBLIC_AGENCY_ROOT=/demo-agency

# Display names (optional).
PUBLIC_APP_NAME="Agency Brain"
PUBLIC_AGENCY_NAME="Northlight Studio"
PUBLIC_OWNER_NAME="the agency owner"

# Your own Fulcra user ID. Required when DEMO_FIXTURES=false: the owner can
# edit brains and manage access; everyone else reads what the owner shared.
OWNER_USER_ID=
